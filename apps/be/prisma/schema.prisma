// AGENT.md 기준 Prisma 스키마 (MySQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Category {
  OS
  NETWORK
  DB
  DATA_STRUCTURE
}

enum Difficulty {
  EAZY
  MEDIUM
  HARD
}

model Question {
  id           BigInt     @id @default(autoincrement())
  category     Category
  difficulty   Difficulty
  topicId      String
  content      String     @db.Text
  contentHash  String     @db.Char(64)
  mustInclude  Json
  timeLimitSec Int        @default(180)
  createdAt    DateTime   @default(now())

  @@index([category, difficulty])
  @@index([category, difficulty, topicId])
  @@unique([category, difficulty, topicId, contentHash], name: "category_difficulty_topicId_contentHash")
}
