# Server
PORT=3000

# Database (MySQL)
# 개발용 Docker(MySQL) 예시: mysql://root:rootpass@127.0.0.1:3307/talkit
DATABASE_URL="mysql://root:rootpass@127.0.0.1:3307/talkit"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# NCloud Object Storage (S3 호환)
OBJECT_STORAGE_BUCKET_NAME=talk-it
NCP_ACCESS_KEY_ID=your-access-key
NCP_SECRET_ACCESS_KEY=your-secret-key
NCLOUD_OBJECT_ENDPOINT=https://kr.object.ncloudstorage.com

# 1. 빌더의 '설정' 메뉴 > '연동 정보' 탭에서 확인
CLOVA_SPEECH_INVOKE_URL=your-invoke-url
CLOVA_SPEECH_SECRET_KEY=your-secret-key

CLOVA_API_KEY=your-api-key
CLOVA_API_KEY_EVAL=your-eval-api-key
CLOVA_API_KEY_FEEDBACK=your-feedback-api-key
CLOVA_API_KEY_GOLDEN=your-golden-api-key
CLOVA_GOLDEN_CACHE_TTL_SEC=86400
# 루브릭 항목 상한(피드백/이슈 길이 제어)
ASSESS_RUBRIC_MAX_ITEMS=6
CLOVA_MODEL=HCX-003
CLOVA_NORMAL_MODEL=HCX-003
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com

# [JWT]
JWT_ACCESS_SECRET=your_strong_access_secret_key
JWT_ACCESS_EXPIRATION_TIME=1h

JWT_REFRESH_SECRET=your_strong_refresh_secret_key
JWT_REFRESH_EXPIRATION_TIME=14d

# (옵션) 기타 서비스용 키들 — 필요 시 설정
# CLOVA_SPEECH_INVOKE_URL=
# CLOVA_SPEECH_SECRET_KEY=
# CLOVA_STT_LANG=Kor
# CLOVA_API_KEY=
# CLOVA_MODEL=
# CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com

# LLM/Question Factory (옵션)
# LLM_MODE=mock
# LLM_MAX_TOKENS=2500
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_MS=45000
# QF_OVERGEN_FACTOR=2
# QF_CHUNK_SIZE=5
# QF_MAX_CALLS_PER_CELL=20
# QF_EXPORT_MODE=overwrite
# QF_SEED_EXISTING=true
# QF_FORCE_CONCEPT_LEVELS=Basic,Intermediate,Advanced
# QF_FORCE_QUESTION_DEPTHS=Low
# QF_N_PER_CELL=5
# QF_VERSION=v2
# QF_DOMAINS=OS
