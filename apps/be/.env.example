# 서버
PORT = 3000

# 빌더의 '설정' 메뉴 > '연동 정보' 탭에서 확인
# **** 를 실제 값으로 교체하세요 -> 노션 '헷' CLOVA Speech 설정 방법 참고
CLOVA_SPEECH_INVOKE_URL=****
CLOVA_SPEECH_SECRET_KEY=****

# Object Storage 정보 (파일 저장 경로를 코드로 전달하기 위해 필요)

# Object Storage에 음성 파일이 저장될 버킷 이름
OBJECT_STORAGE_BUCKET_NAME=talk-it

# Object Storage 액세스를 위한 Key
# "네이버클라우드홈 > 마이페이지 > 계정 관리 > 인증키 관리" 에서 발급
# **** 를 실제 값으로 교체하세요
NCP_ACCESS_KEY_ID=****
NCP_SECRET_ACCESS_KEY=****

# 언어
CLOVA_STT_LANG=Kor

CLOVA_API_KEY=****
CLOVA_MODEL=HCX-007
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com

# LLM mode: mock or real (default: mock)
LLM_MODE=mock
# Cost controls (defaults applied if unset)
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.2
# Network safety (ms)
LLM_TIMEOUT_MS=45000

# Question Factory over-generation multiplier (default: 1)
# 실제 LLM에서 검증/중복제거로 일부가 탈락하는 것을 보정하기 위해
# 셀당 생성 수를 늘리고 싶을 때 사용합니다. 예: 1.5 또는 2
QF_OVERGEN_FACTOR=1
