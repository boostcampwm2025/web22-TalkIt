  "blueprint_generation_hints": {
    "recommended_seed_usage": {
      "mode": "term_only",
      "prompt_language": "ko-KR",
      "low_depth_templates_ko": [
        "{term}란 무엇인가요?",
        "{term}를 한 문장으로 정의하고 핵심 특징 2가지를 말해보세요.",
        "{term}의 목적(역할)은 무엇인가요?",
        "{term}의 주요 구성요소는 무엇인가요?"
      ],
      "validation_defaults": {
        "prompt_min_chars": 20,
        "prompt_max_chars": 120,
        "must_include_min": 3,
        "must_include_max": 5
      }
    }
  }
